@article{nataleERPFMRICorrelates2006,
  title = {{{ERP}} and {{fMRI}} Correlates of Endogenous and Exogenous Focusing of Visual-spatial Attention},
  author = {Natale, E. and Marzi, C. A. and Girelli, M. and Pavone, E. F. and Pollmann, S.},
  year = 2006,

@article{kellyOrthographicCuesLexical1998,
  title = {Orthographic Cues to Lexical Stress: {{Effects}} on Naming and Lexical Decision},
  author = {Kelly, Michael H. and Morris, Joanna and Verrekia, Laura},
  year = 1998,
  journal = {Memory \& Cognition},
  volume = {26},
  number = {4},
  pages = {822--832},
  abstract = {Words whose spellings represent regular phonemic patterns, such as mint, show advantages in naming and lexical decision tasks over words, such as pint, that have exceptional relations between orthographic and phonemic patterns. The authors extended such phenomena to the domain of lexical stress, by showing that disyllabic words whose spellings are consistent with their stress are easier to process than words whose spellings are misleading about stress. Such words were named more quickly and are pronounced with incorrect stress less often (Exp 1). They were also classified more quickly and accurately in lexical decision tasks (Exps 2 and 3). Results indicate that literate speakers have learned orthographic correlates to lexical stress in English. In addition, the similarities between results in the phonemic and prosodic domains indicate that models of reading developed for the former could be extended to the latter area. (PsycINFO Database Record (c) 2012 APA, all rights reserved)},
  copyright = {All rights reserved},
  keywords = {college students,college students Cues Lexical Decision Naming Orthography Word Recognition Syllables,Cues,Lexical Decision,Naming,orthographic cues to lexical stress,Orthography,Syllables,Word,word naming \& lexical decision,word recognition},

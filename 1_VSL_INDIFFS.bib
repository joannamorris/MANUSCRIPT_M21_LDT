@book{AssessmentRelationshipDerivational,
  title = {Assessment of the Relationship between Derivational Morphological Awareness and Second Language Reading Comprehension},
  journal = {Enhancing Beginner-Level Foreign Language Education for Adult Learners},
  pages = {254--269},
  publisher = {Routledge},
  doi = {10.4324/9781003058441-20},
  urldate = {2022-12-12},
  abstract = {The purpose of this correlational study was to examine the crosslinguistic transfer of derivational morphological awareness in German and Russian beginning adult learners of English and how it contributed to their reading comprehension in English. Vocabulary knowledge was also assessed because it served as the link between derivational morphological awareness and second language reading comprehension. In the German group, none of the predictors were significantly correlated with reading comprehension, whereas there was evidence of crosslinguistic derivational morphological awareness transfer. However, Germans' reading comprehension score was not significantly different from the reading score in the Russian group where there was no evidence of the crosslinguistic derivational morphological awareness transfer. Russian derivational morphological awareness was not significantly correlated with reading comprehension, although the other independent variables (English derivational morphological awareness and vocabulary knowledge) were found to predict reading comprehension.},
  isbn = {978-1-003-05844-1},
  langid = {english}
}

@article{assinkPrefixesAccessUnits2000,
  title = {Prefixes as Access Units in Visual Word Recognition: {{A}} Comparison of {{Italian}} and {{Dutch}} Data},
  author = {Assink, Egbert M. and Vooijs, Caroline and Knuijt, Paul P.},
  year = 2000,
  journal = {Reading \& Writing},
  volume = {12},
  number = {3-4},
  pages = {149--168},
  abstract = {Two experiments were conducted to compare morphological processing of skilled (adults) and less skilled (children) Dutch readers (20-24 vs 11-12 yr olds, respectively). Prefixes and suffixes provide morphological information concerning meaning and/or function of the word stem. There is some empirical support for the hypothesis that these sublexical access units are functionally involved in the process of word recognition. These studies focus on the role of prefixes as access units in visual word recognition. Adult readers and children were presented a lexical decision task using polysyllabic word and nonword items. Prefix Frequency (high/low) and Quality (true/pseudo prefix ratio) were manipulated. Evidence was found for differential use of prefix information in both groups. Characteristic difference patterns between skilled and less skilled readers are discussed. It is concluded that the information accessed by prefixes is semantically combined with the subsequent word stem (root). Characteristics of the prefix plus stem combination largely determine speed of access to the complex word item processed. The results are compared to those of A. Laudanna et al (1994) with the Italian language. (PsycINFO Database Record (c) 2002 APA, all rights reserved).},
  keywords = {(18,(18-29,(6-12,(birth-12,(Language),[2820].,*Age,*Age Differences,*Lexical,*Lexical Decision,*Morphology,*Morphology (Language),*Reading,*Reading Skills,*Word,*Word Recognition,\&,Adulthood,Age,Childhood,Cognitive,Cognitive \& Perceptual Development [2820].,Decision,Development,Differences,Human.,Human. Childhood (birth-12 yrs). School Age (6-12,older).,Perceptual,Recognition,School,Skills,Young,yrs,yrs).},
  annotation = {Kluwer Academic, Netherlands Empirical Study. Journal Article. English}
}

@article{baayenAmorphousModelMorphological2011,
  title = {An Amorphous Model for Morphological Processing in Visual Comprehension Based on Naive Discriminative Learning},
  author = {Baayen, Harald and Milin, Petar and Durdevic, Dusica Filipovic and Hendrix, Peter and Marelli, Marco},
  year = 2011,
  month = jul,
  journal = {Psychological Review},
  volume = {118},
  number = {3},
  pages = {438--481},
  issn = {1939-1471},
  doi = {10.1037/a0023851},
  urldate = {2014-03-17},
  abstract = {A 2-layer symbolic network model based on the equilibrium equations of the Rescorla--Wagner model (Danks, 2003) is proposed. The study first presents 2 experiments in Serbian, which reveal for sentential reading the inflectional paradigmatic effects previously observed by Milin, Filipovi\'c \DJ ur\dj evi\'c, and Moscoso del Prado Mart\'in (2009) for unprimed lexical decision. The empirical results are successfully modeled without having to assume separate representations for inflections or data structures such as inflectional paradigms. In the next step, the same naive discriminative learning approach is pitted against a wide range of effects documented in the morphological processing literature. Frequency effects for complex words as well as for phrases (Arnon \& Snider, 2010) emerge in the model without the presence of whole-word or whole-phrase representations. Family size effects (Moscoso del Prado Mart\'in, Bertram, H\"aiki\"o, Schreuder, \& Baayen, 2004; Schreuder \& Baayen, 1997) emerge in the simulations across simple words, derived words, and compounds, without derived words or compounds being represented as such. It is shown that for pseudo-derived words no special morpho-orthographic segmentation mechanism, as posited by Rastle, Davis, and New (2004), is required. The model also replicates the finding of Plag and Baayen (2009) that, on average, words with more productive affixes elicit longer response latencies; at the same time, it predicts that productive affixes afford faster response latencies for new words. English phrasal paradigmatic effects modulating isolated word reading are reported and modeled, showing that the paradigmatic effects characterizing Serbian case inflection have crosslinguistic scope. (PsycINFO Database Record (c) 2012 APA, all rights reserved) (journal abstract)},
  keywords = {*Cognitive Processes,*Comprehension,*Discrimination Learning,*Morphology (Language),*Visual Perception,a-morphous morphology,Cognitive Processes,compound cue theory,Comprehension,Cues,Discrimination Learning,morphological processing,Morphology (Language),naive discriminative learning,Rescorla--Wagner equations,Theories,visual comprehension,visual perception},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/F7THUPIU/Baayen et al. - 2011 - An amorphous model for morphological processing in.pdf}
}


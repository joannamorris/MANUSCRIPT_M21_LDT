  year = 1979,
  journal = {Memory \& Cognition},
  volume = {7},
  number = {4},
  pages = {263--272},
  abstract = {Reports 3 experiments with 60 Ss in which the word frequency effect was used as a method for determining whether affixed words coming from the same stem are stored together or separately in the lexicon. Prefixed words were examined in Exp I, inflected words in Exps II-III. In Exps II, 2 types of words were compared but were varied on the frequency of their stems or base frequency. Lexical decision times were influenced by base frequency, indicating that words related by affixation were stored together in the lexicon. Exp III demonstrated that when base frequency was held constant and surface frequency was varied, lexical decision times were influenced by surface frequency. A model of word recognition whereby frequency has its effect at 2 different stages of the recognition process explains the results. (18 ref) (PsycINFO Database Record (c) 2002 APA, all rights reserved).},
  keywords = {(Learning),(Phonetic,[2340].,*Human,*Human Information Storage,*Reaction,*Reaction Time,*Recognition,*Recognition (Learning),*Word,*Word Frequency,*Words,*Words (Phonetic Units),Cognitive,Cognitive Processes [2340].,Frequency,Human.,Information,Processes,Storage,Time,Units)},
  annotation = {Psychonomic Society, US Journal Article. English},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/BQKB9AGU/taft1979a.pdf}
}


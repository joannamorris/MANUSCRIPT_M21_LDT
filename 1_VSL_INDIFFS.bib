@article{vogelVisualN1Component2000,
  title = {The Visual {{N1}} Component as an Index of a Discrimination Process},
  author = {Vogel, Edward K. and Luck, Steven J.},
  year = 2000,
  month = mar,
  journal = {Psychophysiology},
  volume = {37},
  number = {2},
  pages = {190--203},
  issn = {0048-5772, 1469-8986},
  doi = {10.1111/1469-8986.3720190},
  urldate = {2025-05-15},
  abstract = {Many previous studies have demonstrated that the visual N1 component is larger for attended-location stimuli than for unattended-location stimuli. This difference is observed typically only for tasks involving a discrimination of the attended-location stimuli, suggesting that the N1 wave reflects a discrimination process that is applied to the attended location. The present study tested this hypothesis by examining the N1 component elicited by attended stimuli under conditions that either required or did not require the subject to perform a discrimination. Specifically, the N1 elicited by foveal stimuli during choice-reaction time \textasciitilde RT! tasks was compared with the N1 elicited by identical stimuli during simple-RT tasks. In three experiments, a larger posterior N1 was observed in choice-RT tasks than in simple-RT tasks, even when several potential confounds were eliminated \textasciitilde e.g., arousal and motor preparation!. This N1 discrimination effect was observed even when no motor response was required and was present for both color- and form-based discriminations. Moreover, this discrimination effect was equally large for easy and difficult discriminations, arguing against a simple resource-based explanation of the present results. Instead, the results of this study are consistent with the hypothesis that the visual N1 component reflects the operation of a discrimination process within the focus of attention.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/G8EUPNBV/Vogel and Luck_2000_The visual.pdf}
}


@misc{singmannAfexAnalysisFactorial2024,
  title = {Afex: {{Analysis}} of {{Factorial Experiments}}},
  shorttitle = {Afex},
  author = {Singmann, Henrik and Bolker, Ben and Westfall, Jake and Aust, Frederik and {Ben-Shachar}, Mattan S. and H{\o}jsgaard, S{\o}ren and Fox, John and Lawrence, Michael A. and Mertens, Ulf and Love, Jonathon and Lenth, Russell and Christensen, Rune Haubo Bojesen},
  year = 2024,
  month = sep,
  urldate = {2025-01-10},
  abstract = {Convenience functions for analyzing factorial experiments using ANOVA or mixed models. aov\_ez(), aov\_car(), and aov\_4() allow specification of between, within (i.e., repeated-measures), or mixed (i.e., split-plot) ANOVAs for data in long format (i.e., one observation per row), automatically aggregating multiple observations per individual and cell of the design. mixed() fits mixed models using lme4::lmer() and computes p-values for all fixed effects using either Kenward-Roger or Satterthwaite approximation for degrees of freedom (LMM only), parametric bootstrap (LMMs and GLMMs), or likelihood ratio tests (LMMs and GLMMs). afex\_plot() provides a high-level interface for interaction or one-way plots using ggplot2, combining raw data and model estimates. afex uses type 3 sums of squares as default (imitating commercial statistical software).},
  copyright = {GPL-2 \textbar{} GPL-3 [expanded from: GPL ({$\geq$} 2)]},
  keywords = {MixedModels}
}

@article{singsonRelationReadingAbility2000,
  title = {The Relation between Reading Ability and Morphological Skills: {{Evidence}} from Derivational Suffixes},

@article{dejongProcessingRepresentationDutch2002,
  title = {The Processing and Representation of {{Dutch}} and {{English}} Compounds: {{Peripheral}} Morphological and Central Orthographic Effects},
  shorttitle = {The Processing and Representation of {{Dutch}} and {{English}} Compounds},
  author = {{de Jong}, Nivja H. and Feldman, Laurie Beth and Schreuder, Robert and Pastizzo, Matthew John and Baayen, Harald},
  year = 2002,
  month = apr,
  journal = {Brain and Language},
  volume = {81},
  number = {1-3},
  pages = {555--567},
  issn = {0093-934X},
  doi = {10.1006/brln.2001.2547},
  abstract = {Used the association between various measures of the morphological family and decision latencies to reveal the way in which the components of Dutch and English compounds are processed. 48 undergraduates at Nijmegen University and 20 undergraduates at the State University of New York, Albany participated in this study. The results show that for constituents of concatenated compounds in both languages, a position-related token count of the morphological family plays a role, whereas English open compounds show an effect of a type count, similar to the effect of family size for simplex words. When Dutch compounds are written with an artificial space, they reveal no effect of type count, which shows that the differential effect for the English open compounds is not superficial. The final experiment provides converging evidence for the lexical consequences of the space in English compounds. Decision latencies for English simplex words are better predicted from counts of the morphological family that include concatenated and hyphenated but not open family members. (PsycINFO Database Record (c) 2012 APA, all rights reserved)},

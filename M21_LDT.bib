@incollection{andrewsIndividualDifferencesSkilled2012,
  title = {Individual Differences in Skilled Visual Word Recognition and Reading: {{The}} Role of Lexical Quality},
  shorttitle = {Individual Differences in Skilled Visual Word Recognition and Reading},
  booktitle = {Visual Word Recognition: {{Meaning}} and Context, Individuals and Development, {{Vol}}. 2},
  author = {Andrews, Sally},
  editor = {Adelman, James},
  year = 2012,
  series = {Current Issues in the Psychology of Language},
  pages = {151--172},
  publisher = {Psychology Press},
  address = {New York, NY, US},
  abstract = {In the century since Huey (1908) identified skilled reading as 'one of the most remarkable feats of the human mind', we have learned a lot about how skilled readers identify words. The chapters in this book testify to the large, rich body of evidence that has been accumulated about visual word recognition in skilled readers. The uniformity assumption has served the field of visual word recognition well to this point. The chapters in these two volumes demonstrate that the accumulated evidence about how stimulus and task attributes influence average performance has made significant contributions to the development and refinement of theories of word recognition and reading. It was necessary to establish phenomena that can be robustly observed in average data before attempting to address nuances in its functioning. Many of the subtle effects of stimulus and task factors that have been established may have been difficult to tease out against the welter of individual differences in general cognitive capability and reading-specific skills that might potentially have been measured. (PsycINFO Database Record (c) 2016 APA, all rights reserved)},
  isbn = {978-1-84872-059-6 978-0-203-10697-6},
  keywords = {Individual Differences,Mind,Reading,Word Recognition},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/MUB25KM7/Andrews - 2012 - Individual differences in skilled visual word reco.pdf;/Users/jmorris/Documents/Zotero Data Directory/storage/8FYAL9J3/2012-23042-007.html}
}

@article{andrewsMorphologicalPrimingStronger2013,
  title = {Is Morphological Priming Stronger for Transparent than Opaque Words? {{It}} Depends on Individual Differences in Spelling and Vocabulary},
  shorttitle = {Is Morphological Priming Stronger for Transparent than Opaque Words?},
  author = {Andrews, Sally and Lo, Steson},
  year = 2013,
  month = apr,
  journal = {Journal of Memory and Language},
  volume = {68},
  number = {3},
  pages = {279--296},
  issn = {0749-596X},
  doi = {10.1016/j.jml.2012.12.001},
  urldate = {2015-03-12},
  abstract = {This experiment used the masked priming lexical decision task to address previous contradictory evidence about the relative strength of priming for (i) transparent pairs (e.g., worker WORK) which are morphologically and semantically related; (ii) opaque pairs (e.g., corner CORN) which appear to be morphological relatives but are not semantically related; and (iii) form pairs (e.g., turnip TURN) that are only orthographically related. The average data for 92 university students showed stronger priming effects for transparent than opaque or form pairs, due to a constant `headstart' for related relative to unrelated pairs across the RT distribution. However, these average effects were significantly modulated by individual differences in independent measures of spelling and vocabulary. A `semantic profile', defined by relatively higher vocabulary than spelling, was associated with robust priming for transparent pairs, particularly for slower responses, but little priming for opaque or form pairs. In contrast, individuals with an `orthographic profile' of relatively higher spelling than vocabulary showed sustained priming for opaque pairs that was at least as strong as for transparently related pairs. This evidence of systematic individual differences amongst skilled readers has important implications for theories of lexical representation and processing.},
  keywords = {Lexical retrieval,Masked priming,Morphological priming,Reading skill},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/XD4CGY29/Andrews and Lo - 2013 - Is morphological priming stronger for transparent .pdf}
}

@article{arciuliReadingStatisticalLearning2018,
  title = {Reading as Statistical Learning},
  author = {Arciuli, Joanne},
  year = 2018,
  month = aug,
  journal = {Language, Speech, and Hearing Services in Schools},
  volume = {49},
  number = {3S},
  pages = {634--643},
  publisher = {American Speech-Language-Hearing Association},
  doi = {10.1044/2018_LSHSS-STLT1-17-0135},
  urldate = {2021-12-13},
  abstract = {Purpose The purpose of this tutorial is to explain how learning to read can be thought of as learning statistical regularities and to demonstrate why this is relevant for theory, modeling, and practice. This tutorial also shows how triangulation of methods and cross-linguistic research can be used to gain insight. Method The impossibility of conveying explicitly all of the regularities that children need to acquire in a deep orthography, such as English, can be demonstrated by examining lesser-known probabilistic orthographic cues to lexical stress. Detection of these kinds of cues likely occurs via a type of implicit learning known as statistical learning (SL). The first part of the tutorial focuses on these points. Next, studies exploring how individual differences in the capacity for SL relate to variability in word reading accuracy in the general population are discussed. A brief overview of research linking impaired SL and dyslexia is also provided. The final part of the tutorial focuses on how we might supplement explicit literacy instruction with implicit learning methods and emphasizes the value of testing the efficacy of new techniques in the classroom. The basic and applied research reviewed here includes corpus analyses, behavioral testing, computational modeling, and classroom-based research. Although some of these methods are not commonly used in clinical research, the depth and breadth of this body of work provide a compelling case for why reading can be thought of as SL and how this view can inform practice. Conclusion Implicit methods that draw on the principles of SL can supplement the much-needed explicit instruction that helps children learn to read. This synergy of methods has the potential to spark innovative practices in literacy instruction and remediation provided by educators and clinicians to support typical learners and those with developmental disabilities.},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/UUWFW76D/arciuli_2017.pdf}
}


  pages = {271--294},
  issn = {0169-0965},
  doi = {10.1080/01690969408402120},
  urldate = {2013-06-09},
  abstract = {Abstract A description is given of the main experiments that have been taken as support for the view that, in reading, a prefixed word is stripped of its prefix and lexically accessed on the basis of its stem. Since one of the most important of those experiments had been poorly executed, a new version of the same study is presented with results that are entirely consistent with the previous one. However, logical problems exist with the view that says that stems act as access codes used to gain access to the lexicon, the main ones having to do with the fact that a prefix store is required. As a result, an alternative model is favoured, namely, an interactive-activation model. Prefixed words are represented in decomposed form in this model, but no prelexical prefix-stripping is required. A detailed examination is made of the manner in which this framework is able to incorporate the previous empirical results, as well as other aspects of morphological processing.},
  keywords = {(Language),(Phonetic,[2720].,*Models,*Morphology,*Words,\&,Human.,Language,Linguistics,Speech,Units)},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/8M6VAC88/taft1994.pdf;/Users/jmorris/Documents/Zotero Data Directory/storage/TTSDXMIK/Taft. 1994.pdf;/Users/jmorris/Documents/Zotero Data Directory/storage/G3M3UTHJ/01690969408402120.html;/Users/jmorris/Documents/Zotero Data Directory/storage/N7MBW899/01690969408402120.html}
}

@article{taftMorphologicalDecompositionReverse2004,
  title = {Morphological Decomposition and the Reverse Base Frequency Effect.},
  author = {Taft, Marcus},
  year = 2004,
  month = may,
  journal = {The Quarterly Journal of Experimental Psychology A: Human Experimental Psychology},
  volume = {57A},
  number = {4},
  pages = {745--765},
  issn = {1464-0740},
  abstract = {If recognition of a polymorphemic word always takes place via its decomposition into stem and affix, then the higher the frequency of its stem (i.e., base frequency) the easier the lexical decision response should be when frequency of the word itself (i.e., surface frequency) is controlled. Past experiments have demonstrated such a base frequency effect, but not under all circumstances. Thus, a dual pathway notion has become dominant as an account of morphological processing whereby both decomposition and whole-word access is possible. Two experiments are reported here that demonstrate how an obligatory decomposition account can handle the absence of base frequency effects. In particular, it is shown that the later stage of recombining the stem and affix is harder for high base frequency words than for lower base frequency words when matched on surface frequency, and that this can counterbalance the advantage of easier access to the higher frequency stem. When the combination stage is crucial for discriminating the word items from the nonword items, a reverse base frequency effect emerges, revealing the disadvantage at this stage for high base frequency words. Such an effect is hard for the dual-pathway account to explain, but follows naturally from the idea of obligatory ... (PsycINFO Database Record (c) 2012 APA, all rights reserved) (journal abstract)},
  keywords = {Lexical Decision,morphological decomposition,Morphology,reverse base frequency effect,Word Frequency,word recognition},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/WQAU8WKZ/Taft. 2004.pdf}
}

@article{taftRecognitionAffixedWords1979,
  title = {Recognition of Affixed Words and the Word Frequency Effect},
  author = {Taft, Marcus},
  year = 1979,
  journal = {Memory \& Cognition},
  volume = {7},
  number = {4},
  pages = {263--272},
  abstract = {Reports 3 experiments with 60 Ss in which the word frequency effect was used as a method for determining whether affixed words coming from the same stem are stored together or separately in the lexicon. Prefixed words were examined in Exp I, inflected words in Exps II-III. In Exps II, 2 types of words were compared but were varied on the frequency of their stems or base frequency. Lexical decision times were influenced by base frequency, indicating that words related by affixation were stored together in the lexicon. Exp III demonstrated that when base frequency was held constant and surface frequency was varied, lexical decision times were influenced by surface frequency. A model of word recognition whereby frequency has its effect at 2 different stages of the recognition process explains the results. (18 ref) (PsycINFO Database Record (c) 2002 APA, all rights reserved).},
  keywords = {(Learning),(Phonetic,[2340].,*Human,*Human Information Storage,*Reaction,*Reaction Time,*Recognition,*Recognition (Learning),*Word,*Word Frequency,*Words,*Words (Phonetic Units),Cognitive,Cognitive Processes [2340].,Frequency,Human.,Information,Processes,Storage,Time,Units)},
  annotation = {Psychonomic Society, US Journal Article. English},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/BQKB9AGU/taft1979a.pdf}
}

@article{treimanStatisticalLearningSpelling2018,
  title = {Statistical Learning and Spelling},
  author = {Treiman, Rebecca},
  year = 2018,
  month = aug,
  journal = {Language, Speech, and Hearing Services in Schools},
  volume = {49},
  number = {3S},
  pages = {644--652},
  publisher = {American Speech-Language-Hearing Association},
  doi = {10.1044/2018_LSHSS-STLT1-17-0122},
  urldate = {2022-01-10},
  abstract = {Purpose The purpose of this article is to provide a tutorial on statistical learning and its role in learning to spell and to discuss the implications of the research for educators. Method The tutorial begins with a discussion of statistical learning and its characteristics. It then discusses research on how statistical learning plays out in learning to spell, how spelling should be taught, and similarities and differences among learners. The focus is on the learning of English, although studies of other alphabetic writing systems are also considered. Research shows that, from an early age, children use their statistical learning skills to learn about the visual characteristics of written words. Children also use their statistical learning skills to help learn about the relations between visual units and units of language, supplementing what they are explicitly taught in school. Conclusion Statistical learning plays an important role in learning to spell, and this can help to explain why some aspects of spelling are more difficult to learn than others. If children are to learn to spell effectively and efficiently, structured instruction is also important.},
  keywords = {CHILDREN,COMMUNICATIVE disorders research,LANGUAGE acquisition,LEARNING strategies,ORTHOGRAPHY \& spelling,PHONETICS,PHONOLOGICAL awareness,TREATMENT of communicative disorders},
  file = {/Users/jmorris/Documents/Zotero Data Directory/storage/59GS8GVA/Treiman - 2018 - Statistical Learning and Spelling.pdf}
}

